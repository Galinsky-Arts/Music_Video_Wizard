{
  "name": "music-video-wizard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "worker": "tsx src/worker.ts",
    "test:queue": "tsx scripts/job-queue-smoke.ts",
    "test:graph": "tsx scripts/dependency-graph-smoke.ts",
    "test:inheritance": "tsx scripts/creative-inheritance-smoke.ts",
    "test:library": "tsx scripts/creative-library-smoke.ts",
    "test:kits": "tsx scripts/creative-kits-smoke.ts",
    "test:wizard": "tsx scripts/wizard-shell-smoke.ts",
    "test:analysis": "tsx scripts/music-analysis-smoke.ts",
    "test:map": "tsx scripts/music-map-smoke.ts",
    "test:brief": "tsx scripts/creative-brief-smoke.ts",
    "test:concepts": "tsx scripts/concepts-smoke.ts",
    "test:treatment": "vitest run src/lib/treatment/schema.test.ts",
    "test:creative-language": "vitest run src/lib/creative-language/schema.test.ts",
    "test:song-picture-plan": "vitest run src/lib/song-picture-plan/schema.test.ts",
    "test:visual-aesthetic": "vitest run src/lib/visual-aesthetic/schema.test.ts",
    "test:creative-grammar": "vitest run src/lib/creative-grammar/schema.test.ts",
    "test:motif-typography": "vitest run src/lib/motif/schema.test.ts src/lib/typography-kit/schema.test.ts",
    "test:sequence-map": "vitest run src/lib/sequence-map/schema.test.ts",
    "test:storyboard": "vitest run src/lib/storyboard/schema.test.ts src/lib/storyboard/editor.test.ts",
    "test:acceptance": "tsx scripts/release-acceptance-smoke.ts",
    "ops:status": "tsx scripts/ops-status.ts",
    "production:preflight": "tsx scripts/production-preflight.ts",
    "test:e2e": "playwright test",
    "test:readiness": "tsx scripts/readiness-smoke.ts",
    "audit:prod": "node scripts/audit-production.mjs",
    "ops:asset-integrity": "tsx scripts/asset-integrity.ts",
    "ops:health": "tsx scripts/ops-health.ts",
    "start:production": "prisma migrate deploy && next start -H 0.0.0.0 -p ${PORT:-10000}",
    "ops:production-gate": "tsx scripts/ops-production-gate.ts",
    "test:render": "tsx scripts/render-smoke.ts",
    "predev": "node scripts/build-browser-gpu.mjs",
    "prebuild": "node scripts/build-browser-gpu.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@better-auth/prisma-adapter": "1.7.10",
    "@huggingface/tokenizers": "0.2.0",
    "@mediabunny/aac-encoder": "1.63.0",
    "@prisma/client": "^6.16.2",
    "better-auth": "1.7.10",
    "mediabunny": "1.63.0",
    "next": "^15.5.4",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "pg-boss": "12.36.0",
    "prisma": "^6.16.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "4.23.15",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "esbuild": "0.28.2",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "typescript": "^5.9.2",
    "vitest": "5.0.3"
